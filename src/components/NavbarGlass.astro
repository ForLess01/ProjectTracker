    const inviteBtn = document.getElementById('btn-open-invite');
    if (inviteBtn && !inviteBtn.dataset.listenerAttached) {
      inviteBtn.dataset.listenerAttached = 'true';
      inviteBtn.addEventListener('click', (e) => {
        e.preventDefault();
        window.dispatchEvent(new CustomEvent('open-invite-modal'));
      });
    }
  }

