    const badgeCount = document.getElementById('notif-badge-count');
    const unreadPill = document.getElementById('notif-unread-pill');

    if (notifBtn && popover && !notifBtn.dataset.notifAttached) {
      notifBtn.dataset.notifAttached = 'true';

      notifBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const isHidden = popover.style.display === 'none';
        popover.style.display = isHidden ? 'flex' : 'none';
      });

      document.addEventListener('click', (e) => {
        if (!popover.contains(e.target) && !notifBtn.contains(e.target)) {
          popover.style.display = 'none';
        }
      });

      if (markReadBtn) {
        markReadBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const unreadItems = popover.querySelectorAll('.notif-item.unread');
          unreadItems.forEach((item) => {
            item.classList.remove('unread');
            item.classList.add('read');
            const dot = item.querySelector('.notif-item-dot');
            if (dot) dot.remove();
          });

          if (badgeCount) badgeCount.style.display = 'none';
          if (unreadPill) {
            unreadPill.style.opacity = '0.4';
            const countText = document.getElementById('notif-unread-count-text');
            if (countText) countText.textContent = '0';
          }
        });
      }
    }
  }

  function setupHistoryModal() {
    const openBtn = document.getElementById('btn-open-notif-history');
    const modal = document.getElementById('notif-history-modal');
    const closeBtn = document.getElementById('btn-close-notif-modal');
    const doneBtn = document.getElementById('btn-modal-done');
    const popover = document.getElementById('notif-popover-menu');
    const markAllBtn = document.getElementById('btn-modal-mark-all');
    const searchInput = document.getElementById('notif-search-input');
    const tabs = document.querySelectorAll('.notif-tab-btn');

    if (openBtn && modal && !openBtn.dataset.modalAttached) {
      openBtn.dataset.modalAttached = 'true';

      openBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (popover) popover.style.display = 'none';
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      });

      const closeModal = () => {
        modal.style.display = 'none';
        document.body.style.overflow = '';
      };

      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      if (doneBtn) doneBtn.addEventListener('click', closeModal);

      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });

      if (markAllBtn) {
        markAllBtn.addEventListener('click', () => {
          const unreadItems = modal.querySelectorAll('.notif-item.unread');
          unreadItems.forEach((item) => {
            item.classList.remove('unread');
            item.classList.add('read');
            const dot = item.querySelector('.notif-item-dot');
            if (dot) dot.remove();
          });
        });
      }

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          tabs.forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          const filter = tab.dataset.filter;
          const sections = modal.querySelectorAll('.notif-group-section');

          sections.forEach((sec) => {
            if (filter === 'all') {
              sec.style.display = 'flex';
            } else if (filter === 'today') {
              sec.style.display = sec.dataset.section === 'today' ? 'flex' : 'none';
            } else if (filter === 'week') {
              sec.style.display = (sec.dataset.section === 'today' || sec.dataset.section === 'yesterday' || sec.dataset.section === 'week') ? 'flex' : 'none';
            } else if (filter === 'unread') {
              const unreadInSec = sec.querySelectorAll('.notif-item.unread').length;
              sec.style.display = unreadInSec > 0 ? 'flex' : 'none';
            }
          });
        });
      });

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          const query = e.target.value.toLowerCase().trim();
          const items = modal.querySelectorAll('.notif-item');
          items.forEach((item) => {
            const text = item.textContent.toLowerCase();
            item.style.display = text.includes(query) ? 'flex' : 'none';
          });
        });
      }
    }
  }

  function initNavbar() {
    setupInviteButton();
    setupNotificationsPopover();
    setupHistoryModal();
  }

  initNavbar();
  document.addEventListener('astro:page-load', initNavbar);
</script>
