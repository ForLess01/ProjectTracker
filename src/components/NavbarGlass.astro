---
import LogoMinimal from './LogoMinimal.astro';

interface Props {
  currentView?: string;
  user?: {
    name: string;
    email: string;
    avatarUrl: string;
  } | null;
}

const { currentView = 'hub', user } = Astro.props;

const isHub = currentView === 'hub';

const views = [
  { id: 'ideas', label: 'Ideas', type: 'ideas' },
  { id: 'bugs', label: 'Bugs', type: 'bugs' },
  { id: 'optimizaciones', label: 'Optimizaciones', type: 'optimizaciones' },
  { id: 'implementaciones', label: 'Implementaciones', type: 'implementaciones' },
];

const userInitial = user?.name ? user.name.charAt(0).toUpperCase() : 'U';
---

<header class="navbar-wrapper">
  <div class="navbar-glass-bar">
    
    <!-- Logo with Hub Link -->
    <a href="/app" class="logo-link" title="Ir al Hub de Proyectos y Equipos">
      <LogoMinimal size="md" />
    </a>

    <!-- Center Slot (Rock-solid Absolute Horizontal & Vertical Center) -->
    <div class="nav-center-slot">
      {isHub ? (
        <h1 class="nav-hub-title" title="Hub de Equipos y Proyectos">
          HUB
        </h1>
      ) : (
        <nav class="nav-slider-desktop">
          {views.map((v) => {
            const isActive = currentView === v.id;
            return (
              <a
                href={`/app?view=${v.id}`}
                class={`nav-tab ${isActive ? 'active' : ''} nav-tab-${v.id}`}
                title={v.label}
              >
                <div class={`nav-icon-pill icon-pill-${v.id}`}>
                  {v.type === 'ideas' && (
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M9 18h6" />
                      <path d="M10 22h4" />
                      <path d="M12 2a7 7 0 0 0-7 7c0 2.38 1.19 4.47 3 5.74V17a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-2.26c1.81-1.27 3-3.36 3-5.74a7 7 0 0 0-7-7z" />
                      <line x1="12" y1="6" x2="12" y2="8" />
                      <line x1="9.5" y1="9.5" x2="8.5" y2="10.5" />
                      <line x1="14.5" y1="9.5" x2="15.5" y2="10.5" />
                    </svg>
                  )}
                  {v.type === 'bugs' && (
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect width="8" height="12" x="8" rx="4" />
                      <path d="m19 7-3 2" />
                      <path d="m5 7 3 2" />
                      <path d="m19 19-3-2" />
                      <path d="m5 19 3-2" />
                      <path d="M20 13h-4" />
                      <path d="M4 13h4" />
                      <path d="M10 4.5 9 3" />
                      <path d="M14 4.5 15 3" />
                    </svg>
                  )}
                  {v.type === 'optimizaciones' && (
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                    </svg>
                  )}
                  {v.type === 'implementaciones' && (
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z" />
                      <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z" />
                      <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0" />
                      <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5" />
                    </svg>
                  )}
                </div>
                <span class="tab-label">{v.label}</span>
              </a>
            );
          })}

          <button type="button" class="nav-tab nav-tab-add" id="btn-add-section-nav" title="Añadir nueva sección o hoja">
            <div class="nav-icon-pill icon-pill-add">
              <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
              </svg>
            </div>
            <span class="tab-label">Nueva Sección</span>
          </button>
        </nav>
      )}
    </div>

    <!-- User Profile / Auth Actions -->
    <div class="user-auth-zone">
      {user ? (
        <div class="user-profile-bar">
          
          <!-- Expandable Join Team Button (Landing palette gradient) -->
          <button id="btn-open-invite" class="btn-expandable-invite" title="Unirse a un equipo" aria-label="Unirse a un equipo">
            <div class="btn-icon-box">
              <svg class="btn-invite-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <line x1="19" y1="8" x2="19" y2="14" />
                <line x1="22" y1="11" x2="16" y2="11" />
              </svg>
            </div>
            <span class="btn-expand-label">Unirse a un equipo</span>
          </button>
          
          <!-- User Avatar Pill (Loads Google OAuth avatar with no-referrer, fallback only if missing) -->
          <div class="user-avatar-pill" title={user.name}>
            <div class="avatar-circle">
              {user.avatarUrl ? (
                <img 
                  src={user.avatarUrl} 
                  alt={user.name} 
                  class="user-avatar-img"
                  referrerpolicy="no-referrer"
                  crossorigin="anonymous"
                  onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';"
                />
              ) : null}
              <div class="avatar-fallback" style={user.avatarUrl ? "display: none;" : "display: flex;"}>
                {userInitial}
              </div>
            </div>
            <span class="user-hover-name">{user.name}</span>
          </div>

          <!-- Pure Icon Logout Button with Classic Crimson hover -->
          <form action="/api/auth/logout" method="POST" class="logout-form">
            <button type="submit" class="btn-logout-icon" title="Cerrar Sesión" aria-label="Cerrar Sesión">
              <svg class="logout-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                <polyline points="16 17 21 12 16 7" />
                <line x1="21" y1="12" x2="9" y2="12" />
              </svg>
            </button>
          </form>
        </div>
      ) : (
        <div class="auth-buttons-group">
          <a href="/login" class="btn-login">
            Ingresar
          </a>
          <a href="/register" class="btn-register">
            Registrarse
          </a>
        </div>
      )}
    </div>
  </div>

  <!-- Mobile Navigation Bar (Only in project workspace) -->
  {!isHub && (
    <div class="nav-mobile-bar">
      {views.map((v) => {
        const isActive = currentView === v.id;
        return (
          <a
            href={`/app?view=${v.id}`}
            class={`nav-tab-mobile ${isActive ? 'active' : ''}`}
          >
            {v.type === 'ideas' && (
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 0-7 7c0 2.38 1.19 4.47 3 5.74V17a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-2.26c1.81-1.27 3-3.36 3-5.74a7 7 0 0 0-7-7z"/></svg>
            )}
            {v.type === 'bugs' && (
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="8" height="12" x="8" y="8" rx="4"/><path d="m19 7-3 2"/><path d="m5 7 3 2"/><path d="m19 19-3-2"/><path d="m5 19 3-2"/><path d="M20 13h-4"/><path d="M4 13h4"/></svg>
            )}
            {v.type === 'optimizaciones' && (
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            )}
            {v.type === 'implementaciones' && (
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/></svg>
            )}
            <span>{v.label}</span>
          </a>
        );
      })}
    </div>
  )}
</header>

<style>
  .navbar-wrapper {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 0.75rem 1.25rem;
    max-width: 1440px;
    margin: 0 auto;
    flex-shrink: 0;
  }

  .navbar-glass-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.25rem 0.5rem;
    background: transparent;
    border: none;
    box-shadow: none;
    position: relative;
    min-height: 2.75rem;
  }

  .logo-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    padding-left: 0.25rem;
    z-index: 10;
  }

  /* Center Slot: strictly centered horizontally and vertically in the navbar bar */
  .nav-center-slot {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: auto;
    z-index: 5;
  }

  /* Hub Large Center Title */
  .nav-hub-title {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #ffffff;
    margin: 0;
    padding: 0;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    user-select: none;
    pointer-events: none;
    white-space: nowrap;
    animation: navSimpleFade 0.25s ease-out forwards;
  }

  @keyframes navSimpleFade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Desktop Navigation Slider Container */
  .nav-slider-desktop {
    display: none;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem;
    border-radius: 0.875rem;
    corner-shape: squircle;
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    animation: navSimpleFade 0.25s ease-out forwards;
  }

  @media (min-width: 768px) {
    .nav-slider-desktop {
      display: flex;
    }
  }

  /* Nav Tab - STRICTLY ICON-FIRST in resting state */
  .nav-tab {
    display: inline-flex;
    align-items: center;
    padding: 0.3125rem;
    border-radius: 0.625rem;
    corner-shape: squircle;
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 600;
    color: #94a3b8;
    text-decoration: none;
    position: relative;
    white-space: nowrap;
    overflow: hidden;
    cursor: pointer;
    background: transparent;
    border: 1px solid transparent;
    transition: background-color 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
                border-color 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
                box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* The label is completely collapsed by default with silky-smooth ease */
  .nav-tab .tab-label {
    display: inline-block;
    max-width: 0;
    opacity: 0;
    margin-left: 0;
    overflow: hidden;
    white-space: nowrap;
    transition: max-width 0.35s cubic-bezier(0.4, 0, 0.2, 1), 
                opacity 0.28s cubic-bezier(0.4, 0, 0.2, 1), 
                margin-left 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                margin-right 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* ONLY on hover does the label reveal smoothly */
  .nav-tab:hover .tab-label {
    max-width: 140px;
    opacity: 1;
    margin-left: 0.5rem;
    margin-right: 0.375rem;
  }

  .nav-tab:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
  }

  /* Active Indicator matching exact brand palette */
  .nav-tab-ideas.active {
    color: #ffffff;
    background-color: rgba(63, 136, 197, 0.18);
    border-color: rgba(63, 136, 197, 0.45);
    box-shadow: 0 0 14px rgba(63, 136, 197, 0.3);
  }

  .nav-tab-bugs.active {
    color: #ffffff;
    background-color: rgba(215, 38, 56, 0.18);
    border-color: rgba(215, 38, 56, 0.45);
    box-shadow: 0 0 14px rgba(215, 38, 56, 0.3);
  }

  .nav-tab-optimizaciones.active {
    color: #ffffff;
    background-color: rgba(244, 157, 55, 0.18);
    border-color: rgba(244, 157, 55, 0.45);
    box-shadow: 0 0 14px rgba(244, 157, 55, 0.3);
  }

  .nav-tab-implementaciones.active {
    color: #ffffff;
    background-color: rgba(63, 136, 197, 0.18);
    border-color: rgba(63, 136, 197, 0.45);
    box-shadow: 0 0 14px rgba(63, 136, 197, 0.3);
  }

  /* Nav Icon Pills strictly in Brand Palette */
  .nav-icon-pill {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    corner-shape: squircle;
    background-color: rgba(255, 255, 255, 0.04);
    transition: background-color 0.3s cubic-bezier(0.4, 0, 0.2, 1), color 0.3s ease;
    flex-shrink: 0;
  }

  .icon-pill-ideas { color: var(--color-steel-blue); }
  .icon-pill-bugs { color: var(--color-classic-crimson); }
  .icon-pill-optimizaciones { color: var(--color-carrot-orange); }
  .icon-pill-implementaciones { color: var(--color-steel-blue); }
  .icon-pill-add { color: #94a3b8; }

  .nav-tab:hover .nav-icon-pill {
    background-color: rgba(255, 255, 255, 0.1);
  }

  .nav-icon {
    width: 1.05rem;
    height: 1.05rem;
  }

  /* User Auth Zone */
  .user-auth-zone {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-left: auto;
    z-index: 10;
  }

  .user-profile-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Expandable Invite Button in Brand Palette (Carrot Orange to Classic Crimson) */
  .btn-expandable-invite {
    display: inline-flex;
    align-items: center;
    height: 2.375rem;
    min-width: 2.375rem;
    padding: 0.25rem;
    box-sizing: border-box;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    color: #ffffff;
    background: linear-gradient(135deg, var(--color-carrot-orange) 0%, var(--color-classic-crimson) 100%);
    border-radius: 0.75rem;
    border: none;
    box-shadow: 0 4px 12px rgba(244, 157, 55, 0.3);
    cursor: pointer;
    overflow: hidden;
    white-space: nowrap;
    transition: box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1), filter 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .btn-icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.875rem;
    height: 1.875rem;
    flex-shrink: 0;
  }

  .btn-invite-icon {
    width: 1rem;
    height: 1rem;
  }

  .btn-expand-label {
    max-width: 0;
    opacity: 0;
    margin-left: 0;
    overflow: hidden;
    white-space: nowrap;
    transition: max-width 0.35s cubic-bezier(0.4, 0, 0.2, 1), 
                opacity 0.28s cubic-bezier(0.4, 0, 0.2, 1), 
                margin-left 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                margin-right 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .btn-expandable-invite:hover {
    box-shadow: 0 6px 16px rgba(244, 157, 55, 0.45);
    filter: brightness(1.08);
  }

  .btn-expandable-invite:hover .btn-expand-label {
    max-width: 160px;
    opacity: 1;
    margin-left: 0.35rem;
    margin-right: 0.625rem;
  }

  /* User Avatar Pill */
  .user-avatar-pill {
    display: inline-flex;
    align-items: center;
    height: 2.375rem;
    min-width: 2.375rem;
    padding: 0;
    box-sizing: border-box;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 9999px;
    cursor: pointer;
    overflow: hidden;
    transition: background-color 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
                border-color 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .avatar-circle {
    width: 2.375rem;
    height: 2.375rem;
    border-radius: 9999px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: linear-gradient(135deg, var(--color-steel-blue) 0%, var(--color-midnight) 100%);
    border: 1.5px solid rgba(255, 255, 255, 0.2);
    box-sizing: border-box;
    transition: border-color 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .user-avatar-pill:hover .avatar-circle {
    border-color: rgba(255, 255, 255, 0.4);
  }

  .user-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .avatar-fallback {
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 800;
    color: #ffffff;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .user-hover-name {
    max-width: 0;
    opacity: 0;
    margin-left: 0;
    overflow: hidden;
    white-space: nowrap;
    font-size: 0.75rem;
    font-weight: 600;
    color: #e2e8f0;
    transition: max-width 0.35s cubic-bezier(0.4, 0, 0.2, 1), 
                opacity 0.28s cubic-bezier(0.4, 0, 0.2, 1), 
                margin-left 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                margin-right 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .user-avatar-pill:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
  }

  .user-avatar-pill:hover .user-hover-name {
    max-width: 140px;
    opacity: 1;
    margin-left: 0.5rem;
    margin-right: 0.625rem;
  }

  /* Pure Icon Logout Button */
  .logout-form {
    display: flex;
    align-items: center;
    margin: 0;
  }

  .btn-logout-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.375rem;
    height: 2.375rem;
    padding: 0.25rem;
    box-sizing: border-box;
    border-radius: 0.625rem;
    corner-shape: squircle;
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    color: #94a3b8;
    cursor: pointer;
    flex-shrink: 0;
    transition: color 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
                background-color 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
                border-color 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .btn-logout-icon:hover {
    color: var(--color-classic-crimson);
    background-color: rgba(215, 38, 56, 0.15);
    border-color: rgba(215, 38, 56, 0.35);
  }

  .logout-svg {
    width: 1rem;
    height: 1rem;
  }

  /* Auth Buttons */
  .auth-buttons-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-login {
    padding: 0.375rem 0.875rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #94a3b8;
    border-radius: 0.5rem;
    transition: all 0.2s ease;
  }

  .btn-login:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.05);
  }

  .btn-register {
    padding: 0.375rem 0.875rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #ffffff;
    background-color: var(--color-steel-blue);
    border-radius: 0.5rem;
    transition: all 0.2s ease;
  }

  .btn-register:hover {
    background-color: var(--color-steel-blue-dark);
  }

  /* Mobile Bar */
  .nav-mobile-bar {
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    margin-top: 0.5rem;
  }

  @media (min-width: 768px) {
    .nav-mobile-bar {
      display: none;
    }
  }

  .nav-tab-mobile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.65rem;
    color: #94a3b8;
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    border-radius: 0.5rem;
  }

  .nav-tab-mobile.active {
    color: #ffffff;
    background-color: rgba(63, 136, 197, 0.2);
  }
</style>

<script>
  function setupInviteButton() {
    const inviteBtn = document.getElementById('btn-open-invite');
    if (inviteBtn && !inviteBtn.dataset.listenerAttached) {
      inviteBtn.dataset.listenerAttached = 'true';
      inviteBtn.addEventListener('click', (e) => {
        e.preventDefault();
        window.dispatchEvent(new CustomEvent('open-invite-modal'));
      });
    }
  }

  setupInviteButton();
  document.addEventListener('astro:page-load', setupInviteButton);
</script>
