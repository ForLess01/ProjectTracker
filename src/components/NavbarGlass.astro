---
import LogoMinimal from './LogoMinimal.astro';

interface Props {
  currentView?: string;
  projectName?: string;
  teamName?: string;
  user?: {
    name: string;
    email: string;
    avatarUrl: string;
  } | null;
}

const { currentView = 'hub', projectName = 'proj-1', teamName = 'Engineering Team', user } = Astro.props;

const isHub = currentView === 'hub';

const views = [
  { id: 'ideas', label: 'Ideas', type: 'ideas' },
  { id: 'bugs', label: 'Bugs', type: 'bugs' },
  { id: 'optimizaciones', label: 'Optimizaciones', type: 'optimizaciones' },
  { id: 'implementaciones', label: 'Implementaciones', type: 'implementaciones' },
];

const userInitial = user?.name ? user.name.charAt(0).toUpperCase() : 'U';
---

<header class="navbar-wrapper">
  <div class="navbar-glass-bar">
    
    <!-- Logo with Project Name (No Pill, Side-by-Side Right of Logo) -->
    <div class="nav-logo-project-wrapper">
      <a href="/app" class="logo-link" title="Ir al Hub de Proyectos y Equipos">
        <LogoMinimal size="md" />
      </a>
      {!isHub && (
        <div class="nav-project-info">
          <span class="nav-project-name">
            {projectName}
          </span>
          <span class="nav-project-team">
            ({teamName})
          </span>
        </div>
      )}
    </div>

    <!-- Center Slot (Rock-solid Absolute Horizontal & Vertical Center) -->
    <div class="nav-center-slot">
      {isHub ? (
        <h1 class="nav-hub-title" title="Hub de Equipos y Proyectos">
          HUB
        </h1>
      ) : (
        <nav class="nav-slider-desktop">
          {views.map((v) => {
            const isActive = currentView === v.id;
            return (
              <a
                href={`/app?view=${v.id}`}
                class={`nav-tab ${isActive ? 'active' : ''} nav-tab-${v.id}`}
                title={v.label}
              >
                <div class={`nav-icon-pill icon-pill-${v.id}`}>
                  {v.type === 'ideas' && (
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M9 18h6" />
                      <path d="M10 22h4" />
                      <path d="M12 2a7 7 0 0 0-7 7c0 2.38 1.19 4.47 3 5.74V17a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-2.26c1.81-1.27 3-3.36 3-5.74a7 7 0 0 0-7-7z" />
                      <line x1="12" y1="6" x2="12" y2="8" />
                      <line x1="9.5" y1="9.5" x2="8.5" y2="10.5" />
                      <line x1="14.5" y1="9.5" x2="15.5" y2="10.5" />
                    </svg>
                  )}
                  {v.type === 'bugs' && (
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect width="8" height="12" x="8" rx="4" />
                      <path d="m19 7-3 2" />
                      <path d="m5 7 3 2" />
                      <path d="m19 19-3-2" />
                      <path d="m5 19 3-2" />
                      <path d="M20 13h-4" />
                      <path d="M4 13h4" />
                      <path d="M10 4.5 9 3" />
                      <path d="M14 4.5 15 3" />
                    </svg>
                  )}
                  {v.type === 'optimizaciones' && (
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                    </svg>
                  )}
                  {v.type === 'implementaciones' && (
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z" />
                      <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z" />
                      <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0" />
                      <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5" />
                    </svg>
                  )}
                </div>
                <span class="tab-label">{v.label}</span>
              </a>
            );
          })}

          <button type="button" class="nav-tab nav-tab-add" id="btn-add-section-nav" title="Añadir nueva sección o hoja">
            <div class="nav-icon-pill icon-pill-add">
              <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
              </svg>
            </div>
            <span class="tab-label">Nueva Sección</span>
          </button>
        </nav>
      )}
    </div>

    <!-- User Profile / Auth Actions -->
    <div class="user-auth-zone">
      {user ? (
        <div class="user-profile-bar">
          
          <!-- Expandable Join Team Button (Landing palette gradient) -->
          <button id="btn-open-invite" class="btn-expandable-invite" title="Unirse a un equipo" aria-label="Unirse a un equipo">
            <div class="btn-icon-box">
              <svg class="btn-invite-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <line x1="19" y1="8" x2="19" y2="14" />
                <line x1="22" y1="11" x2="16" y2="11" />
              </svg>
            </div>
            <span class="btn-expand-label">Unirse a un equipo</span>
          </button>
          
          <!-- User Avatar Pill (Loads Google OAuth avatar with no-referrer, fallback only if missing) -->
          <div class="user-avatar-pill" title={user.name}>
            <div class="avatar-circle">
              {user.avatarUrl ? (
                <img 
                  src={user.avatarUrl} 
                  alt={user.name} 
                  class="user-avatar-img"
                  referrerpolicy="no-referrer"
                  crossorigin="anonymous"
                  onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';"
                />
              ) : null}
              <div class="avatar-fallback" style={user.avatarUrl ? "display: none;" : "display: flex;"}>
                {userInitial}
              </div>
            </div>
            <span class="user-hover-name">{user.name}</span>
          </div>

          <!-- Notification Bell Button Container with Counter Badge & Floating Popover Dropdown -->
          <div class="notifications-wrapper">
            <button type="button" class="btn-notification-bell" id="btn-notifications" title="Notificaciones" aria-label="Notificaciones">
              <span class="bell-shake-container">
                <svg class="bell-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
                  <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
                </svg>
                <span class="bell-badge-count" id="notif-badge-count">3</span>
              </span>
            </button>

            <!-- Floating Notification Dropdown Popover Modal (Liquid Glass Premium Edition) -->
            <div class="notifications-popover-menu" id="notif-popover-menu" style="display: none;">
              <div class="notif-popover-header">
                <div class="notif-header-title">
                  <span class="notif-title-text">Notificaciones de hoy</span>
                  <span class="notif-unread-pill" id="notif-unread-pill" title="Notificaciones no le&iacute;das">
                    <svg class="notif-pill-eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                    <span id="notif-unread-count-text">3</span>
                  </span>
                </div>
                <button type="button" class="btn-mark-all-read" id="btn-mark-read" title="Marcar todas como le&iacute;das" aria-label="Marcar todas como le&iacute;das">
                  <svg class="btn-double-check-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 7 17l-5-5"/><path d="m22 10-7.5 7.5L13 16"/></svg>
                </button>
              </div>

              <div class="notif-items-list" id="notif-items-list">
                <!-- Item 1: Task Assignment -->
                <div class="notif-item unread">
                  <div class="notif-avatar-wrapper">
                    <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=120&q=80" alt="Alex Rivera" class="notif-user-avatar" />
                    <div class="notif-badge-icon badge-cyan" title="Asignaci&oacute;n">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/></svg>
                    </div>
                  </div>
                  <div class="notif-item-content">
                    <p class="notif-item-text">
                      <strong class="notif-user-name">Alex Rivera</strong> te asign&oacute; la tarea <span class="notif-tag-blue">Optimizar API Uploads</span>
                    </p>
                    <span class="notif-item-time">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                      5 min
                    </span>
                  </div>
                  <span class="notif-item-dot" title="No le&iacute;da"></span>
                </div>

                <!-- Item 2: Comment -->
                <div class="notif-item unread">
                  <div class="notif-avatar-wrapper">
                    <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=120&q=80" alt="Sofia Chen" class="notif-user-avatar" />
                    <div class="notif-badge-icon badge-orange" title="Comentario">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    </div>
                  </div>
                  <div class="notif-item-content">
                    <p class="notif-item-text">
                      <strong class="notif-user-name">Sofia Chen</strong> coment&oacute; en <span class="notif-tag-orange">Dashboard Kanban View</span>
                    </p>
                    <span class="notif-item-time">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                      25 min
                    </span>
                  </div>
                  <span class="notif-item-dot" title="No le&iacute;da"></span>
                </div>

                <!-- Item 3: Bug Report -->
                <div class="notif-item unread">
                  <div class="notif-avatar-wrapper">
                    <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=120&q=80" alt="Mateo Torres" class="notif-user-avatar" />
                    <div class="notif-badge-icon badge-red" title="Bug Reportado">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="12" x="8" y="8" rx="4"/><path d="m19 7-3 2"/><path d="m5 7 3 2"/><path d="M20 13h-4"/><path d="M4 13h4"/></svg>
                    </div>
                  </div>
                  <div class="notif-item-content">
                    <p class="notif-item-text">
                      <strong class="notif-user-name">Mateo Torres</strong> report&oacute; el bug <span class="notif-tag-red">Error 500 al subir avatar</span>
                    </p>
                    <span class="notif-item-time">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                      1 h
                    </span>
                  </div>
                  <span class="notif-item-dot" title="No le&iacute;da"></span>
                </div>

                <!-- Item 4: Status Move -->
                <div class="notif-item read">
                  <div class="notif-avatar-wrapper">
                    <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=120&q=80" alt="Elena Rostova" class="notif-user-avatar" />
                    <div class="notif-badge-icon badge-emerald" title="Estado Actualizado">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    </div>
                  </div>
                  <div class="notif-item-content">
                    <p class="notif-item-text">
                      <strong class="notif-user-name">Elena Rostova</strong> movi&oacute; a <span class="notif-tag-emerald">Completado</span>
                    </p>
                    <span class="notif-item-time">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                      3 h
                    </span>
                  </div>
                </div>

                <!-- Item 5: PR Approval -->
                <div class="notif-item read">
                  <div class="notif-avatar-wrapper">
                    <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=120&q=80" alt="Carlos Mendoza" class="notif-user-avatar" />
                    <div class="notif-badge-icon badge-cyan" title="PR Aprobado">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    </div>
                  </div>
                  <div class="notif-item-content">
                    <p class="notif-item-text">
                      <strong class="notif-user-name">Carlos Mendoza</strong> aprob&oacute; el PR <span class="notif-tag-blue">#42 Backend Auth</span>
                    </p>
                    <span class="notif-item-time">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                      4 h
                    </span>
                  </div>
                </div>

                <!-- Item 6: Figma Upload -->
                <div class="notif-item read">
                  <div class="notif-avatar-wrapper">
                    <img src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=120&q=80" alt="Luc&iacute;a G&oacute;mez" class="notif-user-avatar" />
                    <div class="notif-badge-icon badge-orange" title="Dise&ntilde;o Subido">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    </div>
                  </div>
                  <div class="notif-item-content">
                    <p class="notif-item-text">
                      <strong class="notif-user-name">Luc&iacute;a G&oacute;mez</strong> subi&oacute; dise&ntilde;o <span class="notif-tag-orange">UI Components V2</span>
                    </p>
                    <span class="notif-item-time">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                      5 h
                    </span>
                  </div>
                </div>

                <!-- Item 7: Column Created -->
                <div class="notif-item read">
                  <div class="notif-avatar-wrapper">
                    <img src="https://images.unsplash.com/photo-1522075469751-3a6694fb2f61?auto=format&fit=crop&w=120&q=80" alt="Javier Silva" class="notif-user-avatar" />
                    <div class="notif-badge-icon badge-emerald" title="Columna Creada">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    </div>
                  </div>
                  <div class="notif-item-content">
                    <p class="notif-item-text">
                      <strong class="notif-user-name">Javier Silva</strong> cre&oacute; columna <span class="notif-tag-emerald">En Pruebas QA</span>
                    </p>
                    <span class="notif-item-time">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                      6 h
                    </span>
                  </div>
                </div>
              </div>

              <button type="button" class="btn-view-all-notifs" id="btn-open-notif-history" title="Abrir historial completo">
                <span>Ver historial</span>
                <svg class="btn-view-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
              </button>
            </div>
          </div>

          <!-- Full History Center Glass Modal -->
          <div class="notif-modal-backdrop" id="notif-history-modal" style="display: none;">
            <div class="notif-modal-container">
              <!-- Modal Header -->
              <div class="notif-modal-header">
                <div class="notif-modal-title-group">
                  <div class="notif-modal-icon-badge">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                  </div>
                  <div>
                    <h2 class="notif-modal-title">Historial de Notificaciones</h2>
                    <p class="notif-modal-subtitle">Registro completo de actividades y eventos del proyecto</p>
                  </div>
                </div>
                <button type="button" class="notif-modal-close-btn" id="btn-close-notif-modal" title="Cerrar modal" aria-label="Cerrar modal">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
              </div>

              <!-- Modal Toolbar / Filter Bar -->
              <div class="notif-modal-toolbar">
                <div class="notif-modal-tabs">
                  <button type="button" class="notif-tab-btn active" data-filter="all">Todas</button>
                  <button type="button" class="notif-tab-btn" data-filter="unread">No le&iacute;das</button>
                  <button type="button" class="notif-tab-btn" data-filter="today">Hoy</button>
                  <button type="button" class="notif-tab-btn" data-filter="week">Esta semana</button>
                </div>
                <div class="notif-modal-search">
                  <svg class="search-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                  <input type="text" placeholder="Buscar en el historial..." class="notif-search-input" id="notif-search-input" />
                </div>
              </div>

              <!-- Modal Body / Content Timeline -->
              <div class="notif-modal-body" id="notif-modal-body">
                <!-- Section 1: Hoy -->
                <div class="notif-group-section" data-section="today">
                  <div class="notif-section-header">
                    <span class="notif-section-title">Hoy</span>
                    <span class="notif-section-count">7 notificaciones</span>
                  </div>
                  <div class="notif-group-items">
                    <div class="notif-item unread">
                      <div class="notif-avatar-wrapper">
                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=120&q=80" alt="Alex Rivera" class="notif-user-avatar" />
                        <div class="notif-badge-icon badge-cyan" title="Asignaci&oacute;n"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/></svg></div>
                      </div>
                      <div class="notif-item-content">
                        <p class="notif-item-text"><strong class="notif-user-name">Alex Rivera</strong> te asign&oacute; la tarea <span class="notif-tag-blue">Optimizar API Uploads</span></p>
                        <span class="notif-item-time"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> 5 min</span>
                      </div>
                      <span class="notif-item-dot"></span>
                    </div>

                    <div class="notif-item unread">
                      <div class="notif-avatar-wrapper">
                        <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=120&q=80" alt="Sofia Chen" class="notif-user-avatar" />
                        <div class="notif-badge-icon badge-orange" title="Comentario"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div>
                      </div>
                      <div class="notif-item-content">
                        <p class="notif-item-text"><strong class="notif-user-name">Sofia Chen</strong> coment&oacute; en <span class="notif-tag-orange">Dashboard Kanban View</span></p>
                        <span class="notif-item-time"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> 25 min</span>
                      </div>
                      <span class="notif-item-dot"></span>
                    </div>

                    <div class="notif-item unread">
                      <div class="notif-avatar-wrapper">
                        <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=120&q=80" alt="Mateo Torres" class="notif-user-avatar" />
                        <div class="notif-badge-icon badge-red" title="Bug Reportado"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect width="8" height="12" x="8" y="8" rx="4"/><path d="m19 7-3 2"/><path d="m5 7 3 2"/><path d="M20 13h-4"/><path d="M4 13h4"/></svg></div>
                      </div>
                      <div class="notif-item-content">
                        <p class="notif-item-text"><strong class="notif-user-name">Mateo Torres</strong> report&oacute; el bug <span class="notif-tag-red">Error 500 al subir avatar</span></p>
                        <span class="notif-item-time"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> 1 h</span>
                      </div>
