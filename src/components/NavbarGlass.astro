---
import LogoMinimal from './LogoMinimal.astro';

interface Props {
  currentView?: string;
  user?: {
    name: string;
    email: string;
    avatarUrl: string;
  } | null;
}

const { currentView = 'ideas', user } = Astro.props;

const views = [
  { id: 'ideas', label: 'Ideas', type: 'lightbulb' },
  { id: 'bugs', label: 'Bugs / Problemas', type: 'bug' },
  { id: 'optimizaciones', label: 'Optimizaciones', type: 'zap' },
  { id: 'implementaciones', label: 'Implementaciones', type: 'rocket' },
];
---

<header class="navbar-wrapper">
  <div class="navbar-glass-bar">
    
    <!-- Logo -->
    <a href="/" class="logo-link">
      <LogoMinimal />
    </a>

    <!-- Desktop Navigation Slider -->
    <nav class="nav-slider-desktop">
      {views.map((v) => {
        const isActive = currentView === v.id;
        return (
          <a
            href={`/app?view=${v.id}`}
            class={`nav-tab ${isActive ? 'active' : ''}`}
          >
            {v.type === 'lightbulb' && (
              <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
            )}
            {v.type === 'bug' && (
              <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m8 2 1.88 1.88"/><path d="M14.12 3.88 16 2"/><path d="M9 7.13v-1a3 3 0 1 1 6 0v1"/><path d="M12 20c-3.3 0-6-2.7-6-6v-3a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v3c0 3.3-2.7 6-6 6"/><path d="M12 20v-9"/></svg>
            )}
            {v.type === 'zap' && (
              <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            )}
            {v.type === 'rocket' && (
              <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/></svg>
            )}
            <span>{v.label}</span>
          </a>
        );
      })}
    </nav>

    <!-- User Profile / Auth Actions -->
    <div class="user-auth-zone">
      {user ? (
        <div class="user-profile-bar">
          <button id="btn-open-invite" class="btn-invite-nav">
            <svg class="btn-invite-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="19" y1="8" x2="19" y2="14"></line><line x1="22" y1="11" x2="16" y2="11"></line></svg>
            <span>Invitar Equipo</span>
          </button>
          
          <div class="user-pill">
            <img src={user.avatarUrl} alt={user.name} class="user-avatar" />
            <span class="user-name">{user.name}</span>
          </div>
          <form action="/api/auth/logout" method="POST">
            <button type="submit" class="btn-logout">
              Salir
            </button>
          </form>
        </div>
      ) : (
        <div class="auth-buttons-group">
          <a href="/login" class="btn-login">
            Ingresar
          </a>
          <a href="/register" class="btn-register">
            Registrarse
          </a>
        </div>
      )}
    </div>
  </div>

  <!-- Mobile Navigation Bar -->
  <div class="nav-mobile-bar">
    {views.map((v) => {
      const isActive = currentView === v.id;
      return (
        <a
          href={`/app?view=${v.id}`}
          class={`nav-tab-mobile ${isActive ? 'active' : ''}`}
        >
          {v.type === 'lightbulb' && (
            <svg class="nav-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
          )}
          {v.type === 'bug' && (
            <svg class="nav-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m8 2 1.88 1.88"/><path d="M14.12 3.88 16 2"/><path d="M9 7.13v-1a3 3 0 1 1 6 0v1"/><path d="M12 20c-3.3 0-6-2.7-6-6v-3a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v3c0 3.3-2.7 6-6 6"/><path d="M12 20v-9"/></svg>
          )}
          {v.type === 'zap' && (
            <svg class="nav-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          )}
          {v.type === 'rocket' && (
            <svg class="nav-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/></svg>
          )}
          <span>{v.label}</span>
        </a>
      );
    })}
  </div>
</header>

<style>
  .navbar-wrapper {
    position: sticky;
    top: 0.5rem;
    z-index: 40;
    padding-left: 1rem;
    padding-right: 1rem;
    max-width: 80rem;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 0.75rem;
  }

  .navbar-glass-bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    border-radius: 1rem;
    background-color: rgba(20, 15, 45, 0.85);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 20px 25px -5px rgba(20, 15, 45, 0.8);
    transition: all 0.3s ease;
  }

  .logo-link {
    transition: opacity 0.2s ease;
  }

  .logo-link:hover {
    opacity: 0.9;
  }

  .nav-slider-desktop {
    display: none;
    align-items: center;
    padding: 0.375rem;
    border-radius: 0.75rem;
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    position: relative;
  }

  @media (min-width: 768px) {
    .nav-slider-desktop {
      display: flex;
    }
  }

  .nav-tab {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-family: var(--font-heading);
    font-weight: 500;
    border-radius: 0.5rem;
    color: #cbd5e1;
    transition: all 0.2s ease;
  }

  .nav-tab:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.05);
  }

  .nav-tab.active {
    color: #ffffff;
    background-color: var(--color-steel-blue);
    box-shadow: 0 10px 15px -3px rgba(63, 136, 197, 0.3);
  }

  .nav-icon {
    width: 1rem;
    height: 1rem;
  }

  .user-auth-zone {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .user-profile-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .btn-invite-nav {
    display: none;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    font-size: 0.75rem;
    font-family: var(--font-heading);
    font-weight: 600;
    color: #ffffff;
    background-color: var(--color-carrot-orange);
    border-radius: 0.75rem;
    box-shadow: 0 4px 6px -1px rgba(244, 157, 55, 0.2);
    transition: all 0.2s ease;
    cursor: pointer;
  }

  @media (min-width: 640px) {
    .btn-invite-nav {
      display: inline-flex;
    }
  }

  .btn-invite-nav:hover {
    background-color: rgba(244, 157, 55, 0.9);
  }

  .btn-invite-icon {
    width: 0.875rem;
    height: 0.875rem;
  }

  .user-pill {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.25rem 0.75rem 0.25rem 0.5rem;
    border-radius: 9999px;
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .user-avatar {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 9999px;
    object-fit: cover;
    outline: 2px solid var(--color-steel-blue);
  }

  .user-name {
    font-size: 0.75rem;
    font-weight: 600;
    color: #e2e8f0;
    display: none;
  }

  @media (min-width: 640px) {
    .user-name {
      display: inline;
    }
  }

  .btn-logout {
    font-size: 0.75rem;
    font-weight: 500;
    color: #94a3b8;
    padding: 0.25rem 0.5rem;
    transition: color 0.2s ease;
    cursor: pointer;
  }

  .btn-logout:hover {
    color: var(--color-racing-red);
  }

  .auth-buttons-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-login {
    padding: 0.5rem 1rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: #e2e8f0;
    transition: color 0.2s ease;
  }

  .btn-login:hover {
    color: var(--color-steel-blue);
  }

  .btn-register {
    padding: 0.5rem 1rem;
    font-size: 0.75rem;
    font-family: var(--font-heading);
    font-weight: 600;
    color: #ffffff;
    background-color: var(--color-steel-blue);
    border-radius: 0.75rem;
    box-shadow: 0 4px 6px -1px rgba(63, 136, 197, 0.3);
    transition: all 0.2s ease;
  }

  .btn-register:hover {
    background-color: rgba(63, 136, 197, 0.9);
  }

  .nav-mobile-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem;
    margin-top: 0.75rem;
    padding: 0.375rem;
    border-radius: 0.75rem;
    background-color: rgba(20, 15, 45, 0.9);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    overflow-x: auto;
  }

  @media (min-width: 768px) {
    .nav-mobile-bar {
      display: none;
    }
  }

  .nav-tab-mobile {
    flex: 1;
    text-align: center;
    padding: 0.375rem 0.75rem;
    font-size: 0.75rem;
    font-family: var(--font-heading);
    font-weight: 500;
    border-radius: 0.5rem;
    white-space: nowrap;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    color: #cbd5e1;
  }

  .nav-tab-mobile.active {
    background-color: var(--color-steel-blue);
    color: #ffffff;
  }

  .nav-icon-sm {
    width: 0.875rem;
    height: 0.875rem;
  }
</style>
