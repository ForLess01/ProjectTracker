---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<div class={`logo-container ${className}`}>
  <div class="logo-icon-box">
    <svg class="logo-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 20h9"></path>
      <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
    </svg>
  </div>
  <span class="logo-text">
    Project<span class="logo-text-highlight">Tracker</span>
  </span>
</div>

<style>
  .logo-container {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .logo-icon-box {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.75rem;
    background: linear-gradient(135deg, #d72638 0%, #f49d37 50%, #3f88c5 100%);
    box-shadow: 0 4px 12px 0 rgba(63, 136, 197, 0.25);
  }

  .logo-icon-svg {
    width: 1rem;
    height: 1rem;
    color: #ffffff;
  }

  .logo-text {
    font-family: var(--font-heading);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: #ffffff;
    font-size: 1.125rem;
  }

  .logo-text-highlight {
    color: #3f88c5;
  }
</style>
