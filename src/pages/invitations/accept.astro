---
import LogoMinimal from '../../components/LogoMinimal.astro';
import { db } from '../../db';
import { projectInvitations, projects } from '../../db/schema';
import { eq } from 'drizzle-orm';

const user = Astro.locals.user;
const token = Astro.url.searchParams.get('token');

let invitation = null;
let project = null;

if (token) {
  invitation = await db.query.projectInvitations.findFirst({
    where: eq(projectInvitations.token, token),
    with: {
      project: true,
    },
  });
  if (invitation) {
    project = invitation.project;
  }
}
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Invitación a Proyecto — Project Tracker</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-slate-950 text-slate-100 font-sans min-h-screen flex items-center justify-center p-4">
    
    <div class="w-full max-w-md p-8 rounded-3xl bg-slate-900/80 backdrop-blur-2xl border border-slate-800 shadow-2xl text-center">
      
      <LogoMinimal className="h-10 w-auto justify-center mb-6" />

      {!invitation || invitation.status !== 'pending' ? (
        <div>
          <h2 class="text-xl font-bold text-red-400 mb-2">Invitación No Válida</h2>
          <p class="text-xs text-slate-400 mb-6">
            El enlace de invitación ha expirado, ya fue aceptado o no existe.
          </p>
          <a href="/app" class="inline-block px-5 py-2.5 text-xs font-semibold text-white bg-indigo-600 rounded-xl">
            Ir al Dashboard
          </a>
        </div>
      ) : (
        <div>
          <span class="inline-block px-3 py-1 rounded-full bg-indigo-500/20 text-indigo-300 text-xs font-semibold mb-4 border border-indigo-500/30">
            Invitación de Colaboración
          </span>
          <h2 class="text-2xl font-bold text-white mb-2">
            Únete a {project?.name || 'este proyecto'}
          </h2>
          <p class="text-xs text-slate-400 mb-6">
            Has sido invitado a unirte a este equipo como <strong class="text-slate-200 capitalize">{invitation.role}</strong>.
          </p>

          {!user ? (
            <div class="space-y-3">
              <p class="text-xs text-amber-300 bg-amber-950/60 border border-amber-800/60 p-3 rounded-xl">
                Debes iniciar sesión o registrarte con el correo <strong>{invitation.email}</strong> para aceptar esta invitación.
              </p>
              <a href={`/login?redirect=/invitations/accept?token=${token}`} class="block w-full py-3 text-xs font-semibold text-white bg-indigo-600 rounded-xl">
                Iniciar Sesión para Aceptar
              </a>
              <a href={`/register?redirect=/invitations/accept?token=${token}`} class="block w-full py-3 text-xs font-medium text-slate-300 bg-slate-800 rounded-xl">
                Crear Cuenta Nueva
              </a>
            </div>
          ) : (
            <div class="space-y-3" id="accept-container">
              <div id="status-msg" class="hidden text-xs p-3 rounded-xl mb-3"></div>
              <button
                id="btn-accept"
                class="w-full py-3 px-4 text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-500 rounded-xl shadow-lg shadow-emerald-600/25 transition-all"
              >
                Aceptar Invitación
              </button>
              <button
                id="btn-reject"
                class="w-full py-2.5 px-4 text-xs font-medium text-slate-400 hover:text-red-400 transition-colors"
              >
                Rechazar
              </button>
            </div>
          )}
        </div>
      )}
    </div>

    <script define:vars={{ token }}>
      const btnAccept = document.getElementById('btn-accept');
      const btnReject = document.getElementById('btn-reject');
      const statusMsg = document.getElementById('status-msg');

      async function processInvite(action) {
        if (!token) return;
        try {
          const res = await fetch('/api/invitations/accept', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ token, action }),
          });

          const data = await res.json();
          if (res.ok && data.success) {
            statusMsg.textContent = data.message;
            statusMsg.className = 'text-xs p-3 rounded-xl mb-3 bg-emerald-950 text-emerald-300 border border-emerald-800';
            statusMsg.classList.remove('hidden');
            setTimeout(() => {
              window.location.href = '/app';
            }, 1500);
          } else {
            statusMsg.textContent = data.error || 'Error al procesar';
            statusMsg.className = 'text-xs p-3 rounded-xl mb-3 bg-red-950 text-red-300 border border-red-800';
            statusMsg.classList.remove('hidden');
          }
        } catch (err) {
          console.error(err);
        }
      }

      btnAccept?.addEventListener('click', () => processInvite('accept'));
      btnReject?.addEventListener('click', () => processInvite('reject'));
    </script>
  </body>
</html>
