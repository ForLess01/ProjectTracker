---
import NavbarGlass from '../../components/NavbarGlass.astro';
import AppWorkspaceManager from '../../components/AppWorkspaceManager.jsx';
import '../../styles/global.css';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}

const url = new URL(Astro.request.url);
const projParam = url.searchParams.get('project');
const viewParam = url.searchParams.get('view');
const isExplicitHub = viewParam === 'hub' || (!projParam && !viewParam);
const currentView = isExplicitHub ? 'hub' : (viewParam || 'ideas');
const projectId = projParam || 'core';
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="shortcut icon" href="/favicon.svg?v=2" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard — Project Tracker</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Raleway:ital,wght@0,100..900;1,100..900&family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap" rel="stylesheet">
  </head>
  <body class="app-body">
    
    <!-- Multi-layered Ambient Background -->
    <div class="gradient-bg app-viewport-gradient">
      <div class="base"></div>
      <div class="treatment"></div>
      <div class="glow"></div>
      <div class="particles"></div>
      <div class="vignette"></div>
      <div class="noise"></div>
      <div class="scanlines"></div>
      <div class="halftone"></div>
      <div class="chromatic"></div>

      <div class="gradient-bg-content app-viewport-content">
        <!-- Collapsed Icon-first Navigation Navbar -->
        <NavbarGlass currentView={currentView} projectId={projectId} user={user} />

        <!-- App Workspace Manager (Hub or Project Table Workspace) -->
        <AppWorkspaceManager client:load initialView={currentView} currentUser={user} />
      </div>
    </div>

    <style>
      :global(html:has(.app-body)),
      :global(body.app-body) {
        height: 100vh;
        height: 100dvh;
        overflow: hidden !important;
      }
      .app-body {
        background-color: var(--color-midnight);
        color: #f1f5f9;
        font-family: var(--font-body);
        height: 100vh;
        height: 100dvh;
        position: relative;
        overflow: hidden !important;
      }
      .app-viewport-gradient {
        height: 100vh;
        height: 100dvh;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }
      .app-viewport-content {
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 0;
        flex: 1;
        overflow: hidden;
      }
    </style>
  </body>
</html>
